#: code:addons/nexa_employee_export/wizard/nexa_employee_export_wizard.py:0
msgid "1. Change the data in the \"Employees\" sheet. Do not change or delete the \"id\" column and the header row."
msgstr "1. Ubah data di sheet \"Employees\". Jangan ubah atau hapus kolom \"id\" dan baris judul."

#. module: nexa_employee_export
#. odoo-python
#: code:addons/nexa_employee_export/wizard/nexa_employee_export_wizard.py:0
msgid "2. In Odoo, open Employees, list view, gear icon, Import records, and upload this file."
msgstr "2. Di Odoo, buka Karyawan, tampilan daftar, ikon roda gigi, Impor rekaman, lalu unggah file ini."

#. module: nexa_employee_export
#. odoo-python
#: code:addons/nexa_employee_export/wizard/nexa_employee_export_wizard.py:0
msgid "3. Choose the \"Employees\" sheet: the columns are mapped by themselves, the headers are the technical names of the fields."
msgstr "3. Pilih sheet \"Employees\": kolom terpetakan otomatis karena judulnya nama teknis field."

#. module: nexa_employee_export
#. odoo-python
#: code:addons/nexa_employee_export/wizard/nexa_employee_export_wizard.py:0
msgid "4. Click Test, then Import. A row with the same \"id\" updates that employee."
msgstr "4. Klik Uji, lalu Impor. Baris dengan \"id\" yang sama memperbarui karyawan tersebut."

